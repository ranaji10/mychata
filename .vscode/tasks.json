{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "MyChata: sync check",
      "detail": "Is my copy current with GitHub, and is anyone else changing the same files?",
      "type": "shell",
      "command": "git config core.hooksPath .githooks && bash scripts/sync-check.sh",
      "runOptions": { "runOn": "folderOpen" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
